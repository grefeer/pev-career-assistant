# Production environment variable template
# Copy to .env.prod and fill in all values before deploying.

# MySQL
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# Redis
REDIS_PASSWORD=

# MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Application
APP_AUTH_SECRET=
OBJECT_ENCRYPTION_KEY=

# Proxy trust (required in production)
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Rate limiting
RATE_LIMIT_HMAC_SECRET=

# Image digests (populated by build script)
BACKEND_DIGEST=sha256:PLACEHOLDER
FRONTEND_DIGEST=sha256:PLACEHOLDER
PROMETHEUS_DIGEST=sha256:PLACEHOLDER
GRAFANA_DIGEST=sha256:PLACEHOLDER

# Grafana
GRAFANA_ADMIN_PASSWORD=

# Tencent (optional, for job sync)
TENCENT_DOCS_TOKEN=
