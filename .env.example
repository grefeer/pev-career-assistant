DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
SUPERVISOR_MODEL=deepseek-v4-flash
ANALYST_MODEL=deepseek-v4-flash
REVIEWER_MODEL=deepseek-v4-pro
OPTIMIZER_MODEL=deepseek-v4-pro
COACH_MODEL=deepseek-v4-pro
APP_ENV=development
APP_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=career-assistant-api
JWT_AUDIENCE=career-assistant-web
JWT_TTL_SECONDS=604800
DB_PASSWORD=replace-with-your-mysql-root-password
DATABASE_URL=mysql+pymysql://root:${DB_PASSWORD}@mysql:3306/career_assistant?charset=utf8mb4
REDIS_PASSWORD=replace-with-your-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
MINIO_ROOT_USER=replace-with-random-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-random-minio-root-password
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=career-assistant
OBJECT_STORE_ACCESS_KEY=${MINIO_ROOT_USER}
OBJECT_STORE_SECRET_KEY=${MINIO_ROOT_PASSWORD}
# 运行 `python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"` 生成
OBJECT_ENCRYPTION_KEY=replace-with-32-byte-base64-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXY_CIDRS=
TENCENT_DOCS_TOKEN=
# Optional: if omitted, live Tencent integration tests use TENCENT_DOCS_TOKEN.
TEST_TENCENT_DOCS_TOKEN=
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
JOB_DISCOVERY_PLAYWRIGHT_FALLBACK_ENABLED=true
JOB_DISCOVERY_OCR_ENABLED=true
